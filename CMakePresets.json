{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "desktop",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "coverage",
      "inherits": "desktop",
      "binaryDir": "${sourceDir}/coverage",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BLUE_COVERAGE": "ON"
      }
    },
    {
      "name": "web",
      "inherits": "desktop",
      "binaryDir": "${sourceDir}/build-web",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "BUILD_TESTING": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "desktop",
      "configurePreset": "desktop"
    },
    {
      "name": "coverage",
      "configurePreset": "coverage"
    },
    {
      "name": "web",
      "configurePreset": "web"
    }
  ],
  "testPresets": [
    {
      "name": "desktop",
      "configurePreset": "desktop",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
